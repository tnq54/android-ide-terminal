<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ide_bg_secondary"
    android:orientation="vertical">

    <!-- Top App Bar (compact & mobile safe-area aware) -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_bg_secondary"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:text="&gt;_"
            android:textColor="@color/ide_accent_green"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="TermIDE Studio v2.0"
                android:textColor="@color/ide_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="~/workspace"
                android:textColor="@color/ide_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnToggleSplit"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="⬒ Split"
            android:textColor="@color/ide_accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuickRun"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:singleLine="true"
            android:text="▶ Run"
            android:textColor="@color/ide_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuickTools"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="⚡ Tools"
            android:textColor="@color/ide_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ide_border" />

    <!-- Navigation Mode Tabs (Thumb-friendly height & no text clipping) -->
    <LinearLayout
        android:id="@+id/navTabsBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/ide_bg_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tabBtnTerminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="&gt;_ Terminal"
            android:textColor="@color/ide_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBtnEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="&lt;/&gt; Editor"
            android:textColor="@color/ide_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabBtnFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="📁 Files"
            android:textColor="@color/ide_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ide_border" />

    <!-- Main Content Container (Supports Single-Pane AND Split Editor+Terminal Mode) -->
    <LinearLayout
        android:id="@+id/mainWorkspaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ide_bg_primary"
        android:orientation="vertical">

        <!-- ==================== PANE: CODE EDITOR ==================== -->
        <LinearLayout
            android:id="@+id/paneEditor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Open File Tabs Bar (Multi-Tab Editor) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/ide_bg_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/editorTabsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnCloseEditorTab"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="✕"
                    android:textColor="@color/ide_accent_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Editor Action Bar (Responsive for narrow phone width) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/ide_bg_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvEditorFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="hello.sh"
                    android:textColor="@color/ide_accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnEditorUndo"
                            android:layout_width="32dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_button_surface"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="↶"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnEditorRedo"
                            android:layout_width="32dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_button_surface"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="↷"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnEditorNew"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_button_surface"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:singleLine="true"
                            android:text="+ Mới"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnEditorFind"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_button_surface"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:singleLine="true"
                            android:text="🔍 Tìm"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnEditorSave"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_button_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:singleLine="true"
                            android:text="💾 Lưu"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnEditorRun"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_button_green"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:singleLine="true"
                            android:text="▶ Chạy"
                            android:textColor="@color/ide_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Editor Main Body with Line Numbers -->
            <ScrollView
                android:id="@+id/editorScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/ide_bg_primary"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLineNumbers"
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:background="@color/ide_bg_secondary"
                        android:fontFamily="monospace"
                        android:gravity="end|top"
                        android:lineSpacingExtra="3dp"
                        android:paddingStart="4dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp"
                        android:text="1"
                        android:textColor="@color/ide_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ide_border" />

                    <EditText
                        android:id="@+id/etCodeEditor"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:gravity="start|top"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:scrollHorizontally="false"
                        android:textColor="@color/ide_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Code Symbol Snippet Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/ide_bg_secondary"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/editorSymbolsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Editor Footer Status Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:background="@color/ide_bg_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvEditorStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Ln 1, Col 1  |  0 chars"
                    android:textColor="@color/ide_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEditorLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="SHELL • UTF-8"
                    android:textColor="@color/ide_accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider between Editor and Terminal when Split Mode is active -->
        <View
            android:id="@+id/splitPaneDivider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ide_accent_blue"
            android:visibility="gone" />

        <!-- ==================== PANE: TERMINAL ==================== -->
        <LinearLayout
            android:id="@+id/paneTerminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Session Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@color/ide_bg_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sessionTabsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnCopyTerminal"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:text="📋 Copy"
                    android:textColor="@color/ide_text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnNewSession"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:singleLine="true"
                    android:text="+ Phiên"
                    android:textColor="@color/ide_accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSession"
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="✕"
                    android:textColor="@color/ide_accent_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Terminal Output Console -->
            <ScrollView
                android:id="@+id/terminalScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/ide_bg_primary"
                android:fillViewport="true"
                android:overScrollMode="always"
                android:padding="10dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tvTerminalOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="simple"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ide_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Extra Keys Bar (Thumb-friendly 40dp bar for mobile) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/ide_bg_secondary"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/terminalExtraKeysContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- Command Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/ide_bg_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvPromptSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="$"
                    android:textColor="@color/ide_accent_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCommandInput"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:hint="@string/terminal_input_hint"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/ide_text_primary"
                    android:textColorHint="@color/ide_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnToggleKeyboard"
                    android:layout_width="36dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="⌨"
                    android:textColor="@color/ide_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnSendCommand"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:text="Chạy"
                    android:textColor="@color/ide_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== PANE: FILE EXPLORER ==================== -->
        <LinearLayout
            android:id="@+id/paneFiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Current Directory Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/ide_bg_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/btnFileUp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_button_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="⬆ .."
                    android:textColor="@color/ide_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentDirPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="~/workspace"
                    android:textColor="@color/ide_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnOpenTermInDir"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="&gt;_ Shell"
                    android:textColor="@color/ide_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- File Operations Strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@color/ide_bg_surface"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/btnCreateFile"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="+ Tạo File"
                        android:textColor="@color/ide_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCreateFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="+ Thư mục"
                        android:textColor="@color/ide_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnGlobalSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="🔎 Tìm trong Project"
                        android:textColor="@color/ide_accent_orange"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnHomeWorkspace"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="🏠 Workspace"
                        android:textColor="@color/ide_accent_cyan"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnRefreshFiles"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="🔄 Làm mới"
                        android:textColor="@color/ide_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ide_border" />

            <!-- File ListView -->
            <ListView
                android:id="@+id/lvFiles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/ide_bg_primary"
                android:divider="@color/ide_border"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
